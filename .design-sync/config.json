{
  "projectId": "7e4c5c82-196b-4c54-8aa3-9ec255bc4109",
  "shape": "package",
  "pkg": "alfa-ui",
  "globalName": "AlfaUI",
  "entry": ".design-sync/pkg/entry.ts",
  "buildCmd": "node .design-sync/build.mjs",
  "readmeHeader": ".design-sync/conventions.md",
  "srcDir": "../../resources/js/components",
  "tsconfig": "../tsconfig.json",
  "cssEntry": "build/ds.compiled.css",
  "extraFonts": ["../fonts/fonts.css"],
  "extraEntries": ["lucide-react"],
  "provider": { "component": "TooltipProvider", "props": { "delayDuration": 0 } },
  "overrides": {
    "Dialog": { "cardMode": "single", "viewport": "720x480" },
    "Sheet": { "cardMode": "single", "viewport": "760x560" },
    "Sidebar": { "cardMode": "single", "viewport": "1100x640" },
    "DropdownMenu": { "cardMode": "single", "viewport": "480x360" },
    "Tooltip": { "cardMode": "single", "viewport": "480x260" },
    "Toaster": { "cardMode": "single", "viewport": "640x360" },
    "Table": { "cardMode": "column" },
    "Select": { "cardMode": "single", "primaryStory": "Abierto", "viewport": "480x360" },
    "Alert": { "cardMode": "column" },
    "Card": { "cardMode": "column" },
    "Empty": { "cardMode": "column" },
    "PlaceholderPattern": { "cardMode": "column" },
    "Switch": { "cardMode": "column" },
    "Textarea": { "cardMode": "column" },
    "Photo": { "cardMode": "column" },
    "ProductoCard": { "cardMode": "column" },
    "TarjetaWhatsapp": { "cardMode": "column" },
    "VehicleCard": { "cardMode": "column" },
    "VehicleGrid": { "cardMode": "column" },
    "ProductoGrid": { "cardMode": "column" },
    "ProductoCatalogo": { "cardMode": "column" },
    "Entregas": { "cardMode": "column" },
    "SiteHeader": { "cardMode": "single", "viewport": "1280x160" },
    "SiteFooter": { "cardMode": "column" },
    "Galeria": { "cardMode": "column" },
    "BotonWhatsapp": { "cardMode": "single", "viewport": "480x520" }
  },
  "libOverrides": {
    "dts.mjs": "shadcn exports subcomponents flat (CardHeader, TableRow): group them under the prefix parent even without a namespace compound"
  },
  "componentSrcMap": {
    "ToggleGroup": "../../resources/js/components/ui/toggle-group.tsx",
    "Toaster": "../../resources/js/components/ui/sonner.tsx",
    "Brand": "../../resources/js/components/alfa/brand.tsx",
    "BrandLockup": "../../resources/js/components/alfa/brand.tsx",
    "VehicleGrid": "../../resources/js/components/alfa/vehicle-card.tsx",
    "ProductoGrid": "../../resources/js/components/alfa/producto-card.tsx",
    "BotonWhatsapp": "../../resources/js/components/alfa/boton-whatsapp.tsx",
    "TarjetaWhatsapp": "../../resources/js/components/alfa/boton-whatsapp.tsx",
    "IconoWhatsapp": "../../resources/js/components/alfa/boton-whatsapp.tsx"
  }
}
